<?xml version="1.0"?>
<sdf version="1.9">
  <model name="down_camera">
    <link name="link">
      <gravity>false</gravity>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
      </visual>
      <sensor name="camera" type="camera">
        <pose>0 0 0 0 1.5708 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>down_camera/image</topic>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image><width>320</width><height>240</height></image>
          <clip><near>0.1</near><far>10</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
