<?xml version="1.0"?>
<sdf version="1.9">
  <model name="down_range">
    <link name="link">
      <gravity>false</gravity>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
      </visual>
      <sensor name="range" type="gpu_lidar">
        <pose>0 0 0 0 1.5708 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>down_range/scan</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.1</min><max>5.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </link>
  </model>
</sdf>
