<?xml version="1.0"?>
<!-- B 쪽 시험용 래퍼: 기본 iris(A의 본체 SDF가 아님)에 하향 센서를 고정 조인트로 붙인다. -->
<sdf version="1.9">
  <model name="iris_flow_test">
    <include>
      <uri>model://iris_with_ardupilot</uri>
      <name>iris</name>
    </include>

    <include>
      <uri>model://down_camera</uri>
      <name>down_camera</name>
      <pose>0 0 -0.05 0 0 0</pose>
    </include>
    <include>
      <uri>model://down_range</uri>
      <name>down_range</name>
      <pose>0 0 -0.05 0 0 0</pose>
    </include>

    <joint name="down_camera_joint" type="fixed">
      <parent>iris::iris_with_standoffs::base_link</parent>
      <child>down_camera::link</child>
    </joint>
    <joint name="down_range_joint" type="fixed">
      <parent>iris::iris_with_standoffs::base_link</parent>
      <child>down_range::link</child>
    </joint>
  </model>
</sdf>
