<?xml version="1.0" ?>
<!-- 실내 방 월드: 12m x 12m x 5m, 북쪽(y=+6) 벽 가운데에 문(폭 1m, 높이 2m), 텍스처 바닥 -->
<sdf version="1.9">
  <world name="room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include><uri>model://floor</uri></include>

    <!-- 벽: pose는 중심, size는 x y z. 두께 0.2m, 높이 5m -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.2 5</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6 0 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12 5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 12 5</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12 5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 12 5</size></box></geometry></visual>
      </link>
    </model>

    <!-- 북쪽 벽 = 왼쪽 + 오른쪽 + 문 위 조각. 문: x -0.5..0.5, z 0..2 -->
    <model name="wall_north_left">
      <static>true</static>
      <pose>-3.25 6 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.5 0.2 5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.5 0.2 5</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_north_right">
      <static>true</static>
      <pose>3.25 6 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.5 0.2 5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.5 0.2 5</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_north_lintel">
      <static>true</static>
      <pose>0 6 3.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 0.2 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 0.2 3</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
